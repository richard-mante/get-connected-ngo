---
import "../styles/global.css";
const { title = "Get Connected — Together, we grow", description = "People, possibility, and progress. Get Connected brings communities and opportunities together." } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#0b526b" /><meta name="description" content={description} />
<title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body><slot /><script>import "../scripts/motion";</script></body>
</html>