---
import "../styles/global.css";
const { title, description } = Astro.props;
const apiBase=(import.meta.env.PUBLIC_API_BASE_URL??"http://localhost:8787").replace(/\/$/,"");
let publicSettings:{defaultSeoTitle?:string;defaultSeoDescription?:string;organizationName?:string}={};
try{const response=await fetch(`${apiBase}/api/v1/settings`);if(response.ok){const data=await response.json() as {settings:typeof publicSettings};publicSettings=data.settings??{};}}catch{}
const pageTitle=title??publicSettings.defaultSeoTitle??"Get Connected — Together, we grow";
const pageDescription=description??publicSettings.defaultSeoDescription??"People, possibility, and progress. Get Connected brings communities and opportunities together.";
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#0b526b" /><meta name="description" content={pageDescription} />
<title>{pageTitle}</title>
<meta property="og:title" content={pageTitle} /><meta property="og:description" content={pageDescription} /><meta property="og:type" content="website" /><meta property="og:url" content={Astro.url.href} /><meta name="twitter:card" content="summary_large_image" />
<link rel="canonical" href={Astro.url.origin+Astro.url.pathname} />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body><slot /><script>import "../scripts/motion";</script></body>
</html>