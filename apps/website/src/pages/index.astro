---
import BaseLayout from "../layouts/BaseLayout.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
const apiBase=(import.meta.env.PUBLIC_API_BASE_URL??"http://localhost:8787").replace(/\/$/,"");
type StoryPreview={id:string;type:string;title:string;slug:string;summary:string|null;metadata:Record<string,string>|null;publishedAt:number|null};
let stories:StoryPreview[]=[];let events:StoryPreview[]=[];
try{const response=await fetch(`${apiBase}/api/v1/content`);if(response.ok){const data=await response.json() as {items:StoryPreview[]};stories=(data.items??[]).filter(item=>item.type==="story").slice(0,3);events=(data.items??[]).filter(item=>item.type==="event").slice(0,2);}}catch{}
---
<BaseLayout>
<header class="header" data-header>
<a class="brand" href="/" aria-label="Get Connected home"><span class="mark">✳</span>get<span>connected</span></a>
<nav class="nav" data-nav aria-label="Main navigation"><a href="/about">About</a><a href="/programs">Programs</a><a href="/events">Events</a><a href="#stories">Stories</a><a href="/contact">Contact</a></nav>
<a class="header-cta" href="/get-involved">Get involved ↗</a><button class="menu" data-menu aria-label="Open menu" aria-expanded="false"><i></i><i></i></button>
</header>
<main>
<section class="hero">
<div class="hero-copy">
<p class="eyebrow"><b></b> People. Possibility. Progress.</p>
<h1 data-hero>When we connect,<br /><em>we grow</em> together.</h1>
<p class="lead">Every community has the power to thrive. We bring people, ideas, and opportunities together to make that possibility real.</p>
<div class="actions"><a class="button" href="#work">Explore our work ↗</a><a class="text-link" href="#about">Get to know us →</a></div>
<p class="hero-foot">— Creating change, side by side</p>
</div>
<div class="hero-visual" data-hero-visual>
<div class="hero-photo"><img src="https://images.unsplash.com/photo-1531206715517-5c0ba140b2b8?auto=format&fit=crop&w=1300&q=85" alt="Community members gathering together" fetchpriority="high" /></div>
<div class="photo-note">✳ <span>Small steps.<br /><strong>Shared futures.</strong></span></div>
<div class="float-note">Connection is<br />where change begins. ↗</div>
</div>
<a class="scroll-cue" href="#about">SCROLL TO DISCOVER <span></span></a>
</section>
<section class="intro section" id="about">
<p class="kicker reveal"><span>01</span> Our belief</p>
<div class="intro-grid"><h2 class="reveal">A better future doesn't happen <em>alone.</em></h2><div class="intro-copy reveal"><p>It starts when people come together—with care, courage, and the belief that every person deserves the chance to thrive.</p><a class="text-link" href="#join">Discover our purpose →</a></div></div>
<div class="section-bottom"><span>Community is our starting point</span><span>✳</span></div>
</section>
<section class="work section" id="work">
<p class="kicker reveal"><span>02</span> What we do</p>
<div class="heading-row reveal"><h2>Building possibility,<br /><em>together.</em></h2><p>Real progress grows from listening, learning, and working side by side.</p></div>
<div class="work-grid">
<article class="work-card reveal"><div class="work-image"><img src="https://images.unsplash.com/photo-1511632765486-a01980e01a18?auto=format&fit=crop&w=1200&q=85" alt="People working together around a table" loading="lazy" /><span>01</span></div><div class="card-foot"><div><small>COMMUNITY</small><h3>Stronger, together</h3></div><a class="round" href="#join" aria-label="Get involved with community work">↗</a></div></article>
<article class="work-card offset reveal"><div class="work-image"><img src="https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=1100&q=85" alt="Young people learning together" loading="lazy" /><span>02</span></div><div class="card-foot"><div><small>OPPORTUNITY</small><h3>Room to become</h3></div><a class="round" href="#join" aria-label="Explore opportunities">↗</a></div></article>
</div>
<p class="work-note">Our programs and priorities will be shaped by the needs and voices of the communities we serve. <a class="text-link" href="/programs">Explore published programs →</a></p>
</section>
<section class="statement"><p class="kicker reveal">The heart of Get Connected</p><h2 class="reveal">Every connection<br />can <em>change a story.</em></h2><div class="statement-foot"><span>Listen deeply. Act together.</span><span>Make room for possibility. ↗</span></div></section>
<section class="stories section" id="stories">
<p class="kicker reveal"><span>03</span> Stories from our community</p>
<div class="stories-heading reveal"><div><h2>Every connection<br />has a <em>story.</em></h2><p>Meet the people, ideas, and moments behind our shared progress.</p></div><a class="text-link" href="/stories">All stories →</a></div>
{stories.length ? <div class="latest-stories">{stories.map((story,index)=><article class="latest-story reveal"><span class="story-number">0{index+1}</span><div><small>{story.publishedAt?new Date(story.publishedAt*1000).toLocaleDateString("en-GH",{year:"numeric",month:"short",day:"numeric"}):"GET CONNECTED"}</small><h3><a href={`/stories/${story.slug}`}>{story.title}</a></h3><p>{story.summary??"A story from the Get Connected community."}</p></div><a class="round" href={`/stories/${story.slug}`} aria-label={`Read ${story.title}`}>↗</a></article>)}</div> : <div class="stories-empty reveal"><p>Stories from our community will appear here as Get Connected publishes updates.</p><a class="text-link" href="#join">Be part of the story →</a></div>}
</section>
<section class="stories section" id="events"><p class="kicker reveal"><span>03</span> Gather with us</p><div class="stories-heading reveal"><div><h2>Moments to<br /><em>come together.</em></h2><p>See activities and events published by Get Connected.</p></div><a class="text-link" href="/events">All events →</a></div>{events.length?<div class="latest-stories">{events.map((event,index)=><article class="latest-story reveal"><span class="story-number">{String(index+1).padStart(2,"0")}</span><div><small>{event.metadata?.startAt?new Date(event.metadata.startAt).toLocaleString("en-GH",{dateStyle:"medium",timeStyle:"short"}):"EVENT"}</small><h3><a href={`/events/${event.slug}`}>{event.title}</a></h3><p>{event.summary??"Read more about this event."}{event.metadata?.location?` · ${event.metadata.location}`:""}</p></div><a class="round" href={`/events/${event.slug}`} aria-label={`View ${event.title}`}>↗</a></article>)}</div>:<div class="stories-empty reveal"><p>Events will appear here when Get Connected publishes them.</p><a class="text-link" href="/events">Explore events →</a></div>}</section>
<section class="join section" id="join"><div class="join-inner reveal"><p class="eyebrow">✳ There's a place for you here</p><h2>Let's make good<br /><em>things happen.</em></h2><p>Bring your time, ideas, energy—or simply your curiosity. A stronger future starts with showing up.</p><EnquiryForm /></div></section>
</main>
<footer class="footer"><a class="brand" href="/">✳ get<span>connected</span></a><p>Connection is where change begins.</p><div><span>© {new Date().getFullYear()} Get Connected</span><span>Made for people, with people.</span><a href="#">Back to top ↑</a></div></footer>
</BaseLayout>