---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RichContent from "../../components/RichContent.astro";
export const prerender = false;
const apiBase=(import.meta.env.PUBLIC_API_BASE_URL??"http://localhost:8787").replace(/\/$/,"");
const slug=Astro.params.slug??"";
type Story={id:string;type:string;title:string;slug:string;summary:string|null;body:string|null;publishedAt:number|null};
let story:Story|null=null;let unavailable=false;
try{const response=await fetch(`${apiBase}/api/v1/content/${encodeURIComponent(slug)}`);if(response.ok){const data=await response.json() as {item:Story};story=data.item;}else if(response.status===404){Astro.response.status=404;}else{Astro.response.status=503;unavailable=true;}}catch{Astro.response.status=503;unavailable=true;}
---
<BaseLayout title={story?`${story.title} — Get Connected`:"Story — Get Connected"} description={story?.summary??"A story from the Get Connected community."}>
<header class="header scrolled" data-header><a class="brand" href="/" aria-label="Get Connected home"><span class="mark">✳</span>get<span>connected</span></a><nav class="nav" data-nav aria-label="Main navigation"><a href="/about">About</a><a href="/programs">Programs</a><a href="/events">Events</a><a href="/stories">Stories</a><a href="/contact">Contact</a></nav><a class="header-cta" href="/get-involved">Get involved ↗</a><button class="menu" data-menu aria-label="Open menu" aria-expanded="false"><i></i><i></i></button></header>
<main class="story-page"><a class="story-back" href="/stories">← All stories</a>
{story?<article><header class="story-header"><p class="eyebrow"><b></b> Get Connected / Community</p><h1>{story.title}</h1>{story.summary&&<p class="story-summary">{story.summary}</p>}{story.publishedAt&&<time datetime={new Date(story.publishedAt*1000).toISOString()}>{new Date(story.publishedAt*1000).toLocaleDateString("en-GH",{year:"numeric",month:"long",day:"numeric"})}</time>}</header><RichContent body={story.body} apiBase={apiBase}/></article>:<div class="story-not-found"><h1>{unavailable?"Stories are temporarily unavailable.":"We couldn't find that story."}</h1><p>{unavailable?"Please try again in a little while.":"The story may have been moved or is no longer published."}</p><a class="button" href="/stories">Browse stories ↗</a></div>}
</main>
<footer class="footer"><a class="brand" href="/">✳ get<span>connected</span></a><p>Connection is where change begins.</p><div><span>© {new Date().getFullYear()} Get Connected</span><span>Made for people, with people.</span><a href="#">Back to top ↑</a></div></footer>
</BaseLayout>
