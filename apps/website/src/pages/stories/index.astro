---
import BaseLayout from "../../layouts/BaseLayout.astro";
const apiBase=(import.meta.env.PUBLIC_API_BASE_URL??"http://localhost:8787").replace(/\/$/,"");
type Story={id:string;type:string;title:string;slug:string;summary:string|null;publishedAt:number|null};
let stories:Story[]=[];
try{const response=await fetch(`${apiBase}/api/v1/content`);if(response.ok){const data=await response.json() as {items:Story[]};stories=(data.items??[]).filter(item=>item.type==="story");}}catch{}
---
<BaseLayout title="Stories — Get Connected" description="Stories and updates from the Get Connected community.">
<header class="header scrolled" data-header><a class="brand" href="/" aria-label="Get Connected home"><span class="mark">✳</span>get<span>connected</span></a><nav class="nav" data-nav aria-label="Main navigation"><a href="/#about">Who we are</a><a href="/#work">Our work</a><a href="/stories">Stories</a><a href="/#join">Get involved</a></nav><a class="header-cta" href="/#join">Join the movement ↗</a><button class="menu" data-menu aria-label="Open menu" aria-expanded="false"><i></i><i></i></button></header>
<main class="story-page"><a class="story-back" href="/">← Back to home</a><div class="stories-heading"><div><p class="kicker">Stories / Community</p><h1>Stories that<br /><em>bring us closer.</em></h1><p>People, ideas, and moments from the Get Connected community.</p></div></div>
{stories.length?<div class="latest-stories">{stories.map((story,index)=><article class="latest-story reveal"><span class="story-number">{String(index+1).padStart(2,"0")}</span><div><small>{story.publishedAt?new Date(story.publishedAt*1000).toLocaleDateString("en-GH",{year:"numeric",month:"short",day:"numeric"}):"GET CONNECTED"}</small><h3><a href={`/stories/${story.slug}`}>{story.title}</a></h3><p>{story.summary??"A story from the Get Connected community."}</p></div><a class="round" href={`/stories/${story.slug}`} aria-label={`Read ${story.title}`}>↗</a></article>)}</div>:<div class="stories-empty"><p>No stories have been published yet. Check back as Get Connected shares community updates.</p><a class="text-link" href="/#join">Connect with us →</a></div>}
</main>
<footer class="footer"><a class="brand" href="/">✳ get<span>connected</span></a><p>Connection is where change begins.</p><div><span>© {new Date().getFullYear()} Get Connected</span><span>Made for people, with people.</span><a href="#">Back to top ↑</a></div></footer>
</BaseLayout>
