---
import BaseLayout from "../layouts/BaseLayout.astro";
import RichContent from "../components/RichContent.astro";
export const prerender=false;
const apiBase=(import.meta.env.PUBLIC_API_BASE_URL??"http://localhost:8787").replace(/\/$/,"");
const slug=Astro.params.slug??"";
type Page={type:string;title:string;slug:string;summary:string|null;body:string|null};
let page:Page|null=null;let unavailable=false;
try{const response=await fetch(`${apiBase}/api/v1/content/${encodeURIComponent(slug)}`);if(response.ok){const data=await response.json() as {item:Page};if(data.item.type==="page")page=data.item;else Astro.response.status=404;}else if(response.status===404)Astro.response.status=404;else{Astro.response.status=503;unavailable=true;}}catch{Astro.response.status=503;unavailable=true;}
---
<BaseLayout title={page?`${page.title} — Get Connected`:"Page — Get Connected"} description={page?.summary??"Information from Get Connected."}>
<header class="header scrolled" data-header><a class="brand" href="/" aria-label="Get Connected home"><span class="mark">✳</span>get<span>connected</span></a><nav class="nav" data-nav aria-label="Main navigation"><a href="/about">About</a><a href="/programs">Programs</a><a href="/events">Events</a><a href="/stories">Stories</a><a href="/contact">Contact</a></nav><a class="header-cta" href="/get-involved">Get involved ↗</a><button class="menu" data-menu aria-label="Open menu" aria-expanded="false"><i></i><i></i></button></header>
<main class="story-page"><a class="story-back" href="/">← Back to home</a>{page?<article><header class="story-header"><p class="eyebrow"><b></b> Get Connected</p><h1>{page.title}</h1>{page.summary&&<p class="story-summary">{page.summary}</p>}</header><RichContent body={page.body} apiBase={apiBase}/></article>:<div class="story-not-found"><h1>{unavailable?"This page is temporarily unavailable.":"We couldn't find that page."}</h1><p>{unavailable?"Please try again soon.":"The page may not be published yet."}</p><a class="button" href="/">Back home ↗</a></div>}</main>
<footer class="footer"><a class="brand" href="/">✳ get<span>connected</span></a><p>Connection is where change begins.</p><div><span>© {new Date().getFullYear()} Get Connected</span><a href="/">Home ↑</a></div></footer>
</BaseLayout>
