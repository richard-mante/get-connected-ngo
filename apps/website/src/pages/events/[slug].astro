---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RichContent from "../../components/RichContent.astro";
export const prerender=false;
const apiBase=(import.meta.env.PUBLIC_API_BASE_URL??"http://localhost:8787").replace(/\/$/,"");
const slug=Astro.params.slug??"";
type Item={type:string;title:string;slug:string;summary:string|null;body:string|null;publishedAt:number|null};
let item:Item|null=null;let unavailable=false;
try{const response=await fetch(`${apiBase}/api/v1/content/${encodeURIComponent(slug)}`);if(response.ok){const data=await response.json() as {item:Item};if(data.item.type==="event")item=data.item;else Astro.response.status=404;}else if(response.status===404)Astro.response.status=404;else{Astro.response.status=503;unavailable=true;}}catch{Astro.response.status=503;unavailable=true;}
---
<BaseLayout title={item?`${item.title} — Get Connected Events`:"Event — Get Connected"} description={item?.summary??"Event information from Get Connected."}>
<main class="story-page"><a class="story-back" href="/events">← All events</a>{item?<article><header class="story-header"><p class="eyebrow"><b></b> Get Connected / Event</p><h1>{item.title}</h1>{item.summary&&<p class="story-summary">{item.summary}</p>}</header><RichContent body={item.body} apiBase={apiBase}/></article>:<div class="story-not-found"><h1>{unavailable?"Events are temporarily unavailable.":"We couldn't find that event."}</h1><p>{unavailable?"Please try again soon.":"This event may not be published."}</p><a class="button" href="/events">Browse events ↗</a></div>}</main>
<footer class="footer"><a class="brand" href="/">✳ get<span>connected</span></a><p>Connection is where change begins.</p><div><span>© {new Date().getFullYear()} Get Connected</span><a href="/">Home ↑</a></div></footer>
</BaseLayout>
